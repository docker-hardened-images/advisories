{"@context":"https://openvex.dev/ns/v0.2.0","@id":"https://dhi.docker.com/vex/vex-86913dd666b085cb0cb62fe2f557dd1b","author":"Docker Hardened Images \u003cdhi@docker.com\u003e","role":"Document Creator","timestamp":"2025-06-09T23:02:00.195Z","last_updated":"2026-04-04T14:18:37.118Z","version":6,"statements":[{"@id":"aba04fdb-efbf-4e93-af83-24c580bbfe37","vulnerability":{"name":"CVE-2026-5121"},"timestamp":"2026-04-04T14:18:37.118Z","products":[{"@id":"pkg:deb/debian/libarchive-tools"}],"status":"not_affected","status_notes":"CVE-2026-5121 is an integer overflow in libarchive's zisofs block pointer allocation where (ceil + 1) * 4 wraps to zero when size_t is 4 bytes. This overflow is only exploitable on 32-bit platforms. All DHI images run exclusively on 64-bit (amd64/arm64) where size_t is 8 bytes, making the arithmetic safe.","justification":"vulnerable_code_not_in_execute_path"},{"@id":"62792861-1e2c-4453-a257-9c1047c3a111","vulnerability":{"name":"CVE-2026-5121"},"timestamp":"2026-04-04T14:18:35.643Z","products":[{"@id":"pkg:deb/debian/libarchive-tools"}],"status":"not_affected","status_notes":"CVE-2026-5121 is an integer overflow in libarchive's zisofs block pointer allocation where (ceil + 1) * 4 wraps to zero when size_t is 4 bytes. This overflow is only exploitable on 32-bit platforms. All DHI images run exclusively on 64-bit (amd64/arm64) where size_t is 8 bytes, making the arithmetic safe.","justification":"vulnerable_code_not_in_execute_path"},{"@id":"9560964b-73fe-4da1-a92c-739dfb1cfd0b","vulnerability":{"name":"CVE-2026-4426"},"timestamp":"2026-03-27T15:33:07.299Z","products":[{"@id":"pkg:deb/debian/libarchive-tools"}],"status":"under_investigation","status_notes":"Waiting for upstream fix"},{"@id":"fd3126d9-1a4a-44c5-b6e8-ad2316a97d80","vulnerability":{"name":"CVE-2026-4424"},"timestamp":"2026-03-27T15:33:06.36Z","products":[{"@id":"pkg:deb/debian/libarchive-tools"}],"status":"under_investigation","status_notes":"Waiting for upstream fix"},{"@id":"496ae