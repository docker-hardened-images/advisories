{"@context":"https://openvex.dev/ns/v0.2.0","@id":"https://dhi.docker.com/vex/vex-911aa508ba087596e82931a94f2fa130","author":"Docker Hardened Images \u003cdhi@docker.com\u003e","role":"Document Creator","version":23,"statements":[{"@id":"31875800-892c-40ab-9513-2340f700ff66","vulnerability":{"name":"CVE-2026-6100"},"products":[{"@id":"pkg:deb/debian/python3.13"},{"@id":"pkg:deb/debian/python3.13@3.13.5-2"},{"@id":"pkg:deb/debian/python3.13@3.13.5-2?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"under_investigation","status_notes":"CPython interpreter use-after-free in {LZMA,BZ2,_Zlib}Decompressor.decompress; upstream fix exists (CPython PR 148396) but Debian trixie still ships python3.13 3.13.5-2 without the patched revision in our images. Waiting for Debian security update.","timestamp":"2026-05-04T16:12:18.187Z"},{"@id":"e9e1fff9-ab3a-45ea-82a9-e22fe503303b","vulnerability":{"name":"CVE-2026-6100"},"products":[{"@id":"pkg:deb/debian/python3.13"},{"@id":"pkg:deb/debian/python3.13@3.13.5-2"},{"@id":"pkg:deb/debian/python3.13@3.13.5-2?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"under_investigation","status_notes":"CPython interpreter use-after-free in {LZMA,BZ2,_Zlib}Decompressor.decompress; upstream fix exists (CPython PR 148396) but Debian trixie still ships python3.13 3.13.5-2 without the patched revision in our images. Waiting for Debian security update.","timestamp":"2026-05-04T16:11:57.434Z"},{"@id":"a8ac99b1-c76f-461b-baec-9dae4e809d5c","vulnerability":{"name":"CVE-2026-6100"},"products":[{"@id":"pkg:deb/debian/python3.13"},{"@id":"pkg:deb/debian/python3.13@3.13.5-2"},{"@id":"pkg:deb/debian/python3.13@3.13.5-2?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"not_affected","status_notes":"python3.13 is installed only as a transitive dependency of rlwrap (Debian rlwrap package declares `Depends: python3:any` for its bundled helper scripts). The clojure image does not invoke python at runtime; the entrypoints (clj, clojure, lein) are JVM-launched shell scripts that use rlwrap solely for readline support. The vulnerable use-after-free in the LZMA/BZ2/zlib decompressor (clj_decompress on MemoryError) requires Python code to call into the affected stdlib decompressors, which never occurs during clojure REPL or build workflows. No upstream Debian fix has been released for python3.13 3.13.5-2.","justification":"vulnerable_code_not_in_execute_path","timestamp":"2026-04-30T15:06:46.816Z"},{"@id":"0e4f4891-3274-41cc-b585-e5a96c988a9d","vulnerability":{"name":"CVE-2026-6100"},"products":[{"@id":"pkg:deb/debian/python3.13"},{"@id":"pkg:deb/debian/python3.13@3.13.5-2"},{"@id":"pkg:deb/debian/python3.13@3.13.5-2?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"not_affected","status_notes":"python3.13 is installed only as a transitive dependency of rlwrap (Debian rlwrap package declares `Depends: python3:any` for its bundled helper scripts). The clojure image does not invoke python at runtime; the entrypoints (clj, clojure, lein) are JVM-launched shell scripts that use rlwrap solely for readline support. The vulnerable use-after-free in the LZMA/BZ2/zlib decompressor (clj_decompress on MemoryError) requires Python code to call into the affected stdlib decompressors, which never occurs during clojure REPL or build workflows. No upstream Debian fix has been released for python3.13 3.13.5-2.","justification":"vulnerable_code_not_in_execute_path","timestamp":"2026-04-30T15:06:31.931Z"},{"@id":"6dccdd6e-5b8e-47af-a2fe-6cae9e102e04","vulnerability":{"name":"CVE-2026-6100"},"products":[{"@id":"pkg:deb/debian/python3.13"},{"@id":"pkg:deb/debian/python3.13@3.13.5-2"},{"@id":"pkg:deb/debian/python3.13@3.13.5-2?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"under_investigation","status_notes":"Waiting for upstream","timestamp":"2026-04-23T17:48:45.111Z"},{"@id":"a399d23e-468e-4f9b-b1e3-0a636424c2cd","vulnerability":{"name":"CVE-2026-6100"},