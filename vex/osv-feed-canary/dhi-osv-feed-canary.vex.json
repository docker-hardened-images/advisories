{"@context":"https://openvex.dev/ns/v0.2.0","@id":"https://dhi.docker.com/vex/vex-a663e1d27c6735289ad313b3606a608a","author":"Docker Hardened Images \u003cdhi@docker.com\u003e","role":"Document Creator","version":1,"statements":[{"@id":"c41c07cf-411f-4b94-af5a-79c8f3471a07","vulnerability":{"name":"GO-2026-5932"},"products":[{"@id":"pkg:docker/dhi/osv-feed-canary","subcomponents":[{"@id":"pkg:golang/golang.org/x/crypto@0.58.0"}]},{"@id":"pkg:golang/golang.org/x/crypto@0.58.0"},{"@id":"pkg:oci/dhi.io%2Fosv-feed-canary","subcomponents":[{"@id":"pkg:golang/golang.org/x/crypto@0.58.0"}]},{"@id":"pkg:oci/osv-feed-canary?repository_url=dhi.io","subcomponents":[{"@id":"pkg:golang/golang.org/x/crypto@0.58.0"}]}],"status":"not_affected","status_notes":"GO-2026-5932 is scoped exclusively to the deprecated golang.org/x/crypto/openpgp package tree, which is frozen upstream with no fixed module release; see https://pkg.go.dev/vuln/GO-2026-5932. The docker-engine APK ships dockerd built from Moby 29.7.2, which vendors github.com/ProtonMail/go-crypto for OpenPGP and does not import golang.org/x/crypto/openpgp. go version -m on the published dockerd binary lists golang.org/x/crypto v0.55.0 as a module dependency but no golang.org/x/crypto/openpgp import path, so the advisory OpenPGP code is not present in the shipped artifact.","justification":"vulnerable_code_not_present","timestamp":"2026-09-02T13:15:14.006Z"},{"@id":"11c24dd7-dc60-4dd3-bf11-5c633d8016a9","vulnerability":{"name":"CVE-2026-59890"},"products":[{"@id":"pkg:docker/dhi/osv-feed-canary","subcomponents":[{"@id":"pkg:pypi/setuptools@70.3.0"}]},{"@id":"pkg:oci/dhi.io%2Fosv-feed-canary","subcomponents":[{"@id":"pkg:pypi/setuptools@70.3.0"}]},{"@id":"pkg:oci/osv-feed-canary?repository_url=dhi.io","subcomponents":[{"@id":"pkg:pypi/setuptools@70.3.0"}]},{"@id":"pkg:pypi/setuptools@70.3.0"}],"status":"not_affected","status_notes":"Same pip vendor BOM artifact as CVE-2025-47273. The MANIFEST.in Unicode-normalization sdist exclusion bug is in setuptools' sdist build path; pip does not ship that code—only a pkg_resources subset for importlib metadata.","justification":"vulnerable_code_not_present","timestamp":"2026-07-30T18:09:58.561Z"},{"@id":"c119f893-d2dc-4482-855a-29495c309f07","vulnerability":{"name":"CVE-2025-47273"},"products":[{"@id":"pkg:docker/dhi/osv-feed-canary","subcomponents":[{"@id":"pkg:pypi/setuptools@70.3.0"}]},{"@id":"pkg:oci/dhi.io%2Fosv-feed-canary","subcomponents":[{"@id":"pkg:pypi/setuptools@70.3.0"}]},{"@id":"pkg:oci/osv-feed-canary?repository_url=dhi.io","subcomponents":[{"@id":"pkg:pypi/setuptools@70.3.0"}]},{"@id":"pkg:pypi/setuptools@70.3.0"}],"status":"not_affected","status_notes":"Scanners report setuptools@70.3.0 when pip 26.2's CycloneDX vendor BOM is ingested. DHI python3-pip ships the upstream pip wheel unchanged: pip vendors only a stripped pkg_resources tree derived from setuptools 70.3.0 and does not ship setuptools/package_index.py where this path-traversal flaw lives.","justification":"vulnerable_code_not_present","timestamp":"2026-07-30T18:09:57.514Z"},{"@id":"e3a579ec-e646-4d4e-8b7b-0d2900f319b6","vulnerability":{"name":"CVE-2026-59890"},"products":[{"@id":"pkg:docker/dhi/osv-feed-canary","subcomponents":[{"@id":"pkg:pypi/setuptools@70.3.0"}]},{"@id":"pkg:oci/dhi.io%2Fosv-feed-canary","subcomponents":[{"@id":"pkg:pypi/setuptools@70.3.0"}]},{"@id":"pkg:oci/osv-feed-canary?repository_url=dhi.io","subcomponents":[{"@id":"pkg:pypi/setuptools@70.3.0"}]},{"@id":"pkg:pypi/setuptools@70.3.0"}],"status":"not_affected","status_notes":"Same pip vendor BOM artifact as CVE-2025-47273. The MANIFEST.in Unicode-normalization sdist exclusion bug is in setuptools' sdist build path; pip does not ship that code—only a pkg_resources subset for importlib metadata.","justification":"vulnerable_code_not_present","timestamp":"2026-07-30T18:09:48.011Z"},{"@id":"0ac2c0df-af40-447c-b47b-bef485209975","vulnerability":{"name":"CVE-2025-47273"},"products":[{"@id":"pkg:docker/dhi/o