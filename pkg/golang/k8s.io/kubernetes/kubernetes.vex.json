    {
      "@id": "47518095-b4a0-4709-8e9c-deeb3cbda133",
      "vulnerability": {
        "name": "CVE-2024-7598"
      },
      "timestamp": "2026-03-05T07:50:09.436Z",
      "products": [
        {
          "@id": "pkg:golang/k8s.io/kubernetes"
        },
        {
          "@id": "pkg:golang/k8s.io/kubernetes@1.33.8"
        }
      ],
      "status": "under_investigation",
      "status_notes": "Waiting for upstream fix - comprehensive fix proposed in KEP but not yet implemented. This race condition in kube-apiserver during namespace termination allows network policies to be deleted before pods, creating a brief window where pods run without network policy enforcement. Mitigations include manually deleting pods before namespace deletion or using the network-policy-finalizer controller."
    },
    {
      "@id": "a8b0b873-3ff1-4524-87aa-2df5c658724f",
      "vulnerability": {
        "name": "CVE-2025-1767"
      },
      "timestamp": "2026-03-05T07:50:08.39Z",
      "products": [
        {
          "@id": "pkg:golang/k8s.io/kubernetes"
        },
        {
          "@id": "pkg:golang/k8s.io/kubernetes@1.33.8"
        }
      ],
      "status": "under_investigation",
      "status_notes": "Waiting for upstream fix - gitRepo volumes are deprecated and will not receive security updates. This vulnerability affects all Kubernetes versions and requires operational mitigations (use init containers for git operations instead of gitRepo volumes, or block gitRepo volume usage with Validating Admission Policy)."
    },
