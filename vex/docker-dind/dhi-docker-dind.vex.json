-dind","subcomponents":[{"@id":"pkg:golang/golang.org/x/crypto@0.58.0"}]},{"@id":"pkg:golang/golang.org/x/crypto@0.58.0"},{"@id":"pkg:oci/dhi.io%2Fdocker-dind","subcomponents":[{"@id":"pkg:golang/golang.org/x/crypto@0.58.0"}]},{"@id":"pkg:oci/docker-dind?repository_url=dhi.io","subcomponents":[{"@id":"pkg:golang/golang.org/x/crypto@0.58.0"}]}],"status":"not_affected","status_notes":"GO-2026-5932 is scoped exclusively to the deprecated golang.org/x/crypto/openpgp package tree, which is frozen upstream with no fixed module release; see https://pkg.go.dev/vuln/GO-2026-5932. The docker-engine APK ships dockerd built from Moby 29.7.2, which vendors github.com/ProtonMail/go-crypto for OpenPGP and does not import golang.org/x/crypto/openpgp. go version -m on the published dockerd binary lists golang.org/x/crypto v0.55.0 as a module dependency but no golang.org/x/crypto/openpgp import path, so the advisory OpenPGP code is not present in the shipped artifact.","justification":"vulnerable_code_not_present","timestamp":"2026-09-02T13:15:14.006Z"},{"@id":"445bdbed-8e2b-4d9b-ac64-65d5233d7131","vulnerability":{"name":"CVE-2026-56392"},"products":[{"@id":"pkg:apk/alpine/coreutils@9.11-r1"},{"@id":"pkg:apk/alpine/coreutils@9.11-r1?os_name=alpine\u0026os_version=3.24"},{"@id":"pkg:docker/dhi/docker-dind","subcomponents":[{"@id":"pkg:apk/alpine/coreutils@9.11-r1?os_name=alpine\u0026os_version=3.24"}]},{"@id":"pkg:oci/dhi.io%2Fdocker-dind","subcomponents":[{"@id":"pkg:apk/alpine/coreutils@9.11-r1"}]},{"@id":"pkg:oci/docker-dind?repository_url=dhi.io","subcomponents":[{"@id":"pkg:apk/alpine/coreutils@9.11-r1"}]}],"status":"not_affected","status_notes":"The DHI coreutils package backports the upstream unexpand allocation fix from commit b60a159fdc5bfcf9988d3a4cb6f53abe8ad5d35d.","justification":"inline_mitigations_already_exist","timestamp":"2026-08-30T22:03:22.732Z"},{"@id":"2a4a4530-46b6-4916-9f6d-0397097c3e03","vulnerability":{"name":"CVE-2026-56391"},"products":[{"@id":"pkg:apk/alp