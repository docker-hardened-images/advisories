ubernetes@1.36.2"}],"status":"not_affected","status_notes":"CVE-2024-7598 concerns namespace deletion ordering, where pods could outlive their NetworkPolicies during namespace termination. The Kubernetes 1.33+ sources used for these kube-apiserver packages include OrderedNamespaceDeletion enabled by default, and the namespace deletion implementation deletes pods before other namespaced resources when that gate is enabled.","justification":"inline_mitigations_already_exist","timestamp":"2026-06-24T19:14:17.244Z"},{"@id":"6e7acc53-06b5-4e47-9910-7e69ba10e146","vulnerability":{"name":"CVE-2024-7598"},"products":[{"@id":"pkg:golang/k8s.io/kubernetes"},{"@id":"pkg:golang/k8s.io/kubernetes@1.33.13"},{"@id":"pkg:golang/k8s.io/kubernetes@1.34.9"},{"@id":"pkg:golang/k8s.io/kubernetes@1.35.6"},{"@id":"pkg:golang/k8s.io/kubernetes@1.36.2"}],"status":"not_affected","status_notes":"CVE-2024-7598 concerns namespace deletion ordering, where pods could outlive their NetworkPolicies during namespace termination. The Kubernetes 1.33+ sources used for these kube-apiserver packages include OrderedNamespaceDeletion enabled by default, and the namespace deletion implementation deletes pods before other namespaced resources when that gate is enabled.","justification":"inline_mitigations_already_exist","timestamp":"2026-06-24T19:14:00.689Z"},{"@id":"4749597c-bc02-4f83-b03f-717972b2115d","vulnerability":{"name":"CVE-2024-7598"},"products":[{"@id":"pkg:golang/k8s.io/kubernetes"},{"@id":"pkg:golang/k8s.io/kubernetes@1.36.2"}],"status":"under_investigation","status_notes":"kubectl 1.36.2 is tracked to the latest stable 1.36.x release from the Debian repository. CVE-2024-7598 affects versions \u003e=1.3.0 with no fix available upstream. Monitoring for patched release in the 1.36.x line.","timestamp":"2026-06-21T13:33:03.283Z"},{"@id":"39a32b4a-7629-4b94-896a-e296f106f295","vulnerability":{"name":"CVE-2025-1767"},"products":[{"@id":"pkg:golang/k8s.io/kubernetes"},{"@id":"pkg:golang/k8s.io/kubern