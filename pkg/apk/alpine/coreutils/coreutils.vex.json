{"@context":"https://openvex.dev/ns/v0.2.0","@id":"https://dhi.docker.com/vex/vex-68520417cd137b43d0adc82648f947ba","author":"Docker Hardened Images \u003cdhi@docker.com\u003e","role":"Document Creator","version":9,"statements":[{"@id":"848f9aa4-e5c3-415f-a8e3-6dadb049be74","vulnerability":{"name":"CVE-2026-56392"},"products":[{"@id":"pkg:apk/alpine/coreutils"},{"@id":"pkg:apk/alpine/coreutils@9.8-r2"},{"@id":"pkg:apk/alpine/coreutils@9.8-r2?os_name=alpine\u0026os_version=3.23"}],"status":"not_affected","status_notes":"CVE-2026-56392 is an integer overflow in unexpand buffer allocation that multiplies max_column_width by MB_LEN_MAX. That allocation path was introduced after coreutils 9.8 (multibyte expand/unexpand support; first present in 9.11). Alpine 3.23 ships coreutils 9.8, which still allocates with ximalloc(max_column_width) and does not contain the vulnerable multiply.","justification":"vulnerable_code_not_present","timestamp":"2026-08-30T22:03:23.6Z"},{"@id":"445bdbed-8e2b-4d9b-ac64-65d5233d7131","vulnerability":{"name":"CVE-2026-56392"},"products":[{"@id":"pkg:apk/alpine/coreutils"},{"@id":"pkg:apk/alpine/coreutils@9.11-r1"},{"@id":"pkg:apk/alpine/coreutils@9.11-r1?os_name=alpine\u0026os_version=3.24"}],"status":"not_affected","status_notes":"The DHI coreutils package backports the upstream unexpand allocation fix from commit b60a159fdc5bfcf9988d3a4cb6f53abe8ad5d35d.","justification":"inline_mitigations_already_exist","timestamp":"2026-08-30T22:03:22.732Z"},{"@id":"2a4a4530-46b6-4916-9f6d-0397097c3e03","vulnerability":{"name":"CVE-2026-56391"},"products":[{"@id":"pkg:apk/alpine/coreutils"},{"@id":"pkg:apk/alpine/coreutils@9.11-r1"},{"@id":"pkg:apk/alpine/coreutils@9.11-r1?os_name=alpine\u0026os_version=3.24"},{"@id":"pkg:apk/alpine/coreutils@9.8-r2"},{"@id":"pkg:apk/alpine/coreutils@9.8-r2?os_name=alpine\u0026os_version=3.23"}],"status":"not_affected","status_notes":"The DHI coreutils package backports the upstream uniq -w multibyte find_field() fix from c