{"@context":"https://openvex.dev/ns/v0.2.0","@id":"https://dhi.docker.com/vex/vex-32634d873dbfd1dfab47190a1dd48f15","author":"Docker Hardened Images \u003cdhi@docker.com\u003e","role":"Document Creator","version":27,"statements":[{"@id":"ea189f68-28a4-4354-951f-b62c4ae42ba9","vulnerability":{"name":"CVE-2026-9545"},"products":[{"@id":"pkg:apk/alpine/curl"},{"@id":"pkg:apk/alpine/curl@8.14.1-r3"},{"@id":"pkg:apk/alpine/curl@8.14.1-r3?os_name=alpine\u0026os_version=3.21"},{"@id":"pkg:apk/alpine/curl@8.14.1-r4"},{"@id":"pkg:apk/alpine/curl@8.14.1-r4?os_name=alpine\u0026os_version=3.22"}],"status":"not_affected","status_notes":"Alpine curl is built with OpenSSL and nghttp2 only; configure does not enable ngtcp2/nghttp3 HTTP/3 or QUIC backends. The vulnerable QUIC/HTTP/3 code is not present. Reference: https://curl.se/docs/CVE-2026-9545.html","justification":"vulnerable_code_not_present","timestamp":"2026-08-13T19:34:57.287Z"},{"@id":"84c62e8d-c40d-4fca-bed3-a42a941623e0","vulnerability":{"name":"CVE-2026-9547"},"products":[{"@id":"pkg:apk/alpine/curl"},{"@id":"pkg:apk/alpine/curl@8.14.1-r3"},{"@id":"pkg:apk/alpine/curl@8.14.1-r3?os_name=alpine\u0026os_version=3.21"},{"@id":"pkg:apk/alpine/curl@8.14.1-r4"},{"@id":"pkg:apk/alpine/curl@8.14.1-r4?os_name=alpine\u0026os_version=3.22"}],"status":"not_affected","status_notes":"Alpine curl is configured with --without-libssh2 and without libssh (https://git.alpinelinux.org/aports/tree/main/curl/APKBUILD). SCP/SFTP support is not compiled in, so the vulnerable SSH code path is not present. Reference: https://curl.se/docs/CVE-2026-9547.html","justification":"vulnerable_code_not_present","timestamp":"2026-08-13T19:34:55.223Z"},{"@id":"d80c7ed6-39a8-4aea-ab01-6d77fead1c1d","vulnerability":{"name":"CVE-2026-12064"},"products":[{"@id":"pkg:apk/alpine/curl"},{"@id":"pkg:apk/alpine/curl@8.14.1-r3"},{"@id":"pkg:apk/alpine/curl@8.14.1-r3?os_name=alpine\u0026os_version=3.21"},{"@id":"pkg:apk/alpine/curl@8.14.1-r4"},{"@id":"pkg:apk/alpine/curl@8.14.1-r4?os_name=alpine\u0026os_version=3.22"}],"status":"not_affected","status_notes":"Alpine curl is configured with --without-libssh2 and without libssh (https://git.alpinelinux.org/aports/tree/main/curl/APKBUILD). SCP/SFTP support is not compiled in, so the vulnerable SSH code path is not present. Reference: https://curl.se/docs/CVE-2026-12064.html","justification":"vulnerable_code_not_present","timestamp":"2026-08-13T19:34:54.2Z"},{"@id":"be0f4560-a4a9-45d1-bd92-8a538616387b","vulnerability":{"name":"CVE-2025-14017"},"products":[{"@id":"pkg:apk/alpine/curl"},{"@id":"pkg:apk/alpine/curl@8.14.1-r4"},{"@id":"pkg:apk/alpine/curl@8.14.1-r4?os_name=alpine\u0026os_version=3.22"}],"status":"not_affected","status_notes":"This CVE affects multi-threaded LDAPS (LDAP over TLS) transfers with libcurl. Alpine curl packages are built with --disable-ldap, so the vulnerable LDAP code is not compiled in.","justification":"vulnerable_code_not_present","timestamp":"2026-02-25T00:32:39.126Z"},{"@id":"39869020-1ef6-4b96-a3ca-c80228844098","vulnerability":{"name":"CVE-2025-15224"},"products":[{"@id":"pkg:apk/alpine/curl"},{"@id":"pkg:apk/alpine/curl@8.14.1-r4"},{"@id":"pkg:apk/alpine/curl@8.14.1-r4?os_name=alpine\u0026os_version=3.22"}],"status":"under_investigation","status_notes":"Waiting for upstream fix","timestamp":"2026-01-16T14:41:06.752Z"},{"@id":"2cc3f916-5b77-40ff-bca6-80e238435fa4","vulnerability":{"name":"CVE-2025-15079"},"products":[{"@id":"pkg:apk/alpine/curl"},{"@id":"pkg:apk/alpine/curl@8.14.1-r4"},{"@id":"pkg:apk/alpine/curl@8.14.1-r4?os_name=alpine\u0026os_version=3.22"}],"status":"not_affected","status_notes":"This CVE affects curl when built with libssh backend. Alpine curl packages use libssh2 backend by default, so this vulnerability does not affect our images.","justification":"component_not_present","timestamp":"2026-01-16T14:41:05.341Z"}],"timestamp":"2026-01-16T14:41:05Z","last_updated":"2026-08-13T19:34:57Z"}