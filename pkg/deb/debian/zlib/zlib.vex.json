3A1.3.dfsg%2Breally1.3.1-1%2Bdeb13u0%2Bdhi4?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"not_affected","status_notes":"Debian security tracker: fixed in unstable by the same change as CVE-2026-85091, which is upstream zlib commit df84af25dc1942490e1d1c899a07619152a46148. That change resets the stream input pointer and available input after a failed write() in gz_write(), so a later gz* write cannot use the stale caller buffer. This package build includes an adaptation of that upstream change for the zlib 1.3.1 code base. See https://security-tracker.debian.org/tracker/CVE-2026-76844","justification":"inline_mitigations_already_exist","timestamp":"2026-11-05T13:21:39.819Z"},{"@id":"2f135020-089f-4366-b0c0-9e349fab1b63","vulnerability":{"name":"CVE-2026-85091"},"products":[{"@id":"pkg:deb/debian/zlib"},{"@id":"pkg:deb/debian/zlib@1%3A1.3.dfsg%2Breally1.3.1-1%2Bdeb13u0%2Bdhi4"},{"@id":"pkg:deb/debian/zlib@1%3A1.3.dfsg%2Breally1.3.1-1%2Bdeb13u0%2Bdhi4?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/zlib@1%3A1.3.dfsg%2Breally1.3.1-1%2Bdeb13u0%2Bdhi4?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/zlib@1%3A1.3.dfsg%2Breally1.3.1-1%2Bdeb13u0%2Bdhi4?os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/zlib@1%3A1.3.dfsg%2Breally1.3.1-1%2Bdhi4"},{"@id":"pkg:deb/debian/zlib@1%3A1.3.dfsg%2Breally1.3.1-1%2Bdhi4?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"not_affected","status_notes":"DHI rebuilds prevent a failed direct-buffer gzwrite from leaving a caller-owned input pointer available to gzprintf or gzvprintf. The +dhi4 rebuild applies the pointer-state reset from upstream commit https://github.com/madler/zlib/commit/df84af25dc1942490e1d1c899a07619152a46148 in the equivalent zlib 1.3.1 error branch; +dhi3 guards the later formatting entry points. See https://security-tracker.debian.org/tracker/CVE-2026-85091.","justification":"inline_mitigations_already_exist","timestamp":"2026-09-04T16:47:14.322Z"},{"@id":"58f55f14-ee41-462d-a64d-4267131cecef","vulnerability":{"name":"CVE-2026-27171"},"products":[{"@id":"pkg:deb/debian/zlib"},{"@id":"pkg:deb/debian/zlib@1%3A1.3.dfsg%2Breally1.3.1-1%2Bdeb13u0%2Bdhi4"},{"@id":"pkg:deb/debian/zlib@1%3A1.3.dfsg%2Breally1.3.1-1%2Bdeb13u0%2Bdhi4?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/zlib@1%3A1.3.dfsg%2Breally1.3.1-1%2Bdeb13u0%2Bdhi4?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/zlib@1%3A1.3.dfsg%2Breally1.3.1-1%2Bdeb13u0%2Bdhi4?os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/zlib@1%3A1.3.dfsg%2Breally1.3.1-1%2Bdhi2"},{"@id":"pkg:deb/debian/zlib@1%3A1.3.dfsg%2Breally1.3.1-1%2Bdhi2?os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/zlib@1%3A1.3.dfsg%2Breally1.3.1-1%2Bdhi4"},{"@id":"pkg:deb/debian/zlib@1%3A1.3.dfsg%2Breally1.3.1-1%2Bdhi4?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"not_affected","status_notes":"Upstream patch ba829a458576d1ff0f26fc7230c6de816d1f6a77 applied. Adds negative length checks in crc32_combine64 and crc32_combine_gen64 to prevent CPU consumption from infinite loops.","justification":"inline_mitigations_already_exist","timestamp":"2026-04-29T04:04:49.754Z"},{"@id":"3a7f291f-17ab-5d34-b7ea-41ae8a3a9075","vulnerability":{"name":"CVE-2026-27171"},"products":[{"@id":"pkg:deb/debian/zlib"},{"@id":"pkg:deb/debian/zlib@1%3A1.2.13.dfsg-1"},{"@id":"pkg:deb/debian/zlib@1%3A1.2.13.dfsg-1?arch=amd64\u0026os_distro=bookworm\u0026os_name=debian\u0026os_version=12"},{"@id":"pkg:deb/debian/zlib@1%3A1.2.13.dfsg-1?arch=arm64\u0026os_distro=bookworm\u0026os_name=debian\u0026os_version=12"},{"@id":"pkg:deb/debian/zlib@1%3A1.2.13.dfsg-1?os_distro=bookworm\u0026os_name=debian\u0026os_version=12"}],"status":"not_affected","status_notes":"Marked n