{"@context":"https://openvex.dev/ns/v0.2.0","@id":"https://dhi.docker.com/vex/vex-275cd27eface6999539378f6cd3db4f0","author":"Docker Hardened Images \u003cdhi@docker.com\u003e","role":"Document Creator","version":31,"statements":[{"@id":"cdfde897-ba9f-44b5-9856-5bf83af3585b","vulnerability":{"name":"CVE-2026-103995"},"products":[{"@id":"pkg:deb/debian/python-3.14"},{"@id":"pkg:deb/debian/python-3.14@3.14.10-6"},{"@id":"pkg:deb/debian/python-3.14@3.14.10-6?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/python-3.14@3.14.10-6?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/python-3.14@3.14.10-6?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"not_affected","status_notes":"DHI backport of upstream gh-150751 (python/cpython commits 2eb2af805c156ca52b316bb4ced5e0ab3971d0ae and 9f52b443c002cccfb54bda0706a9276b6b4a109d) applied to 3.10.22 through 3.15.2. http.client validates the Content-Length header as decimal digits only (RFC 9112 1*DIGIT), ignoring optional spaces or tabs around the value; a value with a sign, an underscore, or an embedded space is not used as the body length. Chunk sizes are validated as hexadecimal digits (RFC 9112 1*HEXDIG, 0-9, a-f and A-F), so valid upper- and lower-case hex chunk sizes are accepted, while a sign, a 0x prefix, an underscore or leading whitespace is rejected instead of being parsed with int(value, 16).","justification":"inline_mitigations_already_exist","timestamp":"2026-11-09T15:41:11.837Z"},{"@id":"8eb5d355-5ad7-4431-8def-46c2229b50ea","vulnerability":{"name":"CVE-2026-103995"},"products":[{"@id":"pkg:deb/debian/python-3.14"},{"@id":"pkg:deb/debian/python-3.14@3.14.10-6"},{"@id":"pkg:deb/debian/python-3.14@3.14.10-6?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/python-3.14@3.14.10-6?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"