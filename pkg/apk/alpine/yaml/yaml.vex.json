{"@context":"https://openvex.dev/ns/v0.2.0","@id":"https://dhi.docker.com/vex/vex-29f76870cfa962eb119ee188f9e8b36e","author":"Docker Hardened Images \u003cdhi@docker.com\u003e","role":"Document Creator","version":14,"statements":[{"@id":"f93af316-096b-4e94-87c5-a9fa24b65a83","vulnerability":{"name":"CVE-2026-44842"},"products":[{"@id":"pkg:apk/alpine/yaml"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r3"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r3?arch=aarch64\u0026os_name=alpine\u0026os_version=3.23"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r3?arch=x86_64\u0026os_name=alpine\u0026os_version=3.23"}],"status":"not_affected","status_notes":"Fixed in DHI yaml 0.2.5-r3 by backporting the upstream libyaml nesting depth limit released in 0.2.6 (commits 51843fe48257c6b7b6e70cdec1db634f64a40818, 8362c8dd96b644bda4e4d24cc405ef7f0e642d21, ab16c938fe6bd35c78c42dbab7a75b7a62d23c31, 2ca0fab2b9102fc90baeb244e011579b7d38b1b4 and 849d0aefecb42fe70165ed1557c329aff9e74d3e). The scanner now rejects collections nested deeper than 1000 levels with \"exceeded maximum nesting depth\" instead of growing its stacks without bound. Alpine fixes the same CVE in yaml 0.2.7-r0.","justification":"inline_mitigations_already_exist","timestamp":"2026-11-24T19:45:13.293Z"},{"@id":"a456357d-1055-4c25-91de-2761fe813687","vulnerability":{"name":"CVE-2026-44842"},"products":[{"@id":"pkg:apk/alpine/yaml"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r3"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r3?arch=aarch64\u0026os_name=alpine\u0026os_version=3.23"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r3?arch=x86_64\u0026os_name=alpine\u0026os_version=3.23"}],"status":"not_affected","status_notes":"Fixed in DHI yaml 0.2.5-r3 by backporting the upstream libyaml nesting depth limit released in 0.2.6 (commits 51843fe48257c6b7b6e70cdec1db634f64a40818, 8362c8dd96b644bda4e4d24cc405ef7f0e642d21, ab16c938fe6bd35c78c42dbab7a75b7a62d23c31, 2ca0fab2b9102fc90baeb244e011579b7d38b1b4 and 849d0aefecb42fe70165ed1557c329aff9e74d3e). The scanner now rejects collections nested deeper than 1000 levels with \"exceeded maximum nesting depth\" instead of growing its stacks without bound. Alpine fixes the same CVE in yaml 0.2.7-r0.","justification":"inline_mitigations_already_exist","timestamp":"2026-11-24T19:43:33.038Z"},{"@id":"c75f1cce-5c58-44c9-abda-c513b7e329e1","vulnerability":{"name":"CVE-2022-3064"},"products":[{"@id":"pkg:apk/alpine/yaml"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r2"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r2?arch=aarch64\u0026os_name=alpine\u0026os_version=3.22"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r2?arch=aarch64\u0026os_name=alpine\u0026os_version=3.23"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r2?arch=aarch64\u0026os_name=alpine\u0026os_version=3.24"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r2?arch=x86_64\u0026os_name=alpine\u0026os_version=3.22"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r2?arch=x86_64\u0026os_name=alpine\u0026os_version=3.23"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r2?arch=x86_64\u0026os_name=alpine\u0026os_version=3.24"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r3"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r3?arch=aarch64\u0026os_name=alpine\u0026os_version=3.23"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r3?arch=x86_64\u0026os_name=alpine\u0026os_version=3.23"}],"status":"not_affected","status_notes":"False positive. This CVE is for the Go-based yaml package. See https://github.com/advisories/GHSA-6q6q-88xp-6f2r","justification":"vulnerable_code_not_present","timestamp":"2026-02-25T18:17:51.986Z"},{"@id":"5dd0c77b-60f3-47d2-aa50-13aca18996de","vulnerability":{"name":"CVE-2022-3064"},"products":[{"@id":"pkg:apk/alpine/yaml"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r2"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r2?arch=aarch64\u0026os_name=alpine\u0026os_version=3.22"},{"@id":"pkg:apk/alpine/yaml@0.2.5-r2?arch=x86_64\u0026os_name=alpine\u0026os_version=3.22"}],"status":"not_affected","status_notes":"False positive. This CVE describes a vulnerability in yaml in GoLang, not LibYAML","justification":"component_not_present","timestamp":"2026-02-10T15:51:36.188Z"},{"@id":"6f5