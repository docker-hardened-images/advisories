{"@context":"https://openvex.dev/ns/v0.2.0","@id":"https://dhi.docker.com/vex/vex-924a8d515a9d7890e33739668e2953ff","author":"Docker Hardened Images \u003cdhi@docker.com\u003e","role":"Document Creator","version":13,"statements":[{"@id":"d118df70-c34e-4a4b-ad8d-46ad55d99609","vulnerability":{"name":"CVE-2026-132138"},"products":[{"@id":"pkg:deb/debian/cyrus-sasl2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdeb13u0%2Bdhi2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdeb13u0%2Bdhi2?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdeb13u0%2Bdhi2?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdeb13u0%2Bdhi2?os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"not_affected","status_notes":"The vulnerable code path is absent from the shipped cyrus-sasl2 artifacts. CVE-2026-132138 is a NULL pointer dereference in the SCRAM server when a client sends channel-binding data although the server has no channel-binding configured. The fix is upstream commit 45d66335a4a6a59ef07b6fe8f94ac843c1fd3b86 (https://github.com/cyrusimap/cyrus-sasl/commit/45d66335a4a6a59ef07b6fe8f94ac843c1fd3b86), which adds a NULL check on the server channel-binding type before it is dereferenced in plugins/scram.c. That check is present in the cyrus-sasl 2.1.28 source that Debian packages, and the built libscram plugin in the shipped libsasl2-modules package contains its error message. See https://security-tracker.debian.org/tracker/CVE-2026-132138","justification":"vulnerable_code_not_present","timestamp":"2026-11-25T19:47:17.074Z"},{"@id":"19cd7cd9-d878-4ed0-8e8a-784c9e0a6f6d","vulnerability":{"name":"CVE-2026-132138"},"products":[{"@id":"pkg:deb/debian/cyrus-sasl2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdeb13u0%2Bdhi2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdeb13u0%2Bdhi2?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdeb13u0%2Bdhi2?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdeb13u0%2Bdhi2?os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"not_affected","status_notes":"The vulnerable code path is absent from the shipped cyrus-sasl2 artifacts. CVE-2026-132138 is a NULL pointer dereference in the SCRAM server when a client sends channel-binding data although the server has no channel-binding configured. The fix is upstream commit 45d66335a4a6a59ef07b6fe8f94ac843c1fd3b86 (https://github.com/cyrusimap/cyrus-sasl/commit/45d66335a4a6a59ef07b6fe8f94ac843c1fd3b86), which adds a NULL check on the server channel-binding type before it is dereferenced in plugins/scram.c. That check is present in the cyrus-sasl 2.1.28 source that Debian packages, and the built libscram plugin in the shipped libsasl2-modules package contains its error message. See https://security-tracker.debian.org/tracker/CVE-2026-132138","justification":"vulnerable_code_not_present","timestamp":"2026-11-25T19:45:53.986Z"},{"@id":"2569f01b-5e14-4b50-9d91-4eb9155a6290","vulnerability":{"name":"CVE-2026-129483"},"products":[{"@id":"pkg:deb/debian/cyrus-sasl2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"not_affected","status_notes":"The vulnerable SRP plugin source is absent from the shipped cyrus-sasl2 artifacts. Debian builds cyrus-sasl2 with SRP disabled (--disable-srp, --disable-srp-setpass), and the built libsasl2-2, libsasl2-modules and libsasl2-modules-gssapi-mit packages contain no SRP module and no SRP strings. The SRP plugin was removed upstream in commit fb3724f43dc50247ff2bf02135457d6d77031654 (https://github.com/cyrusimap/cyrus-sasl/commit/fb3724f43dc50247ff2bf02135457d6d77031654). See https://security-tracker.debian.org/tracker/CVE-2026-129483","justification":"vulnerable_code_not_present","timestamp":"2026-11-18T20:21:05.155Z"},{"@id":"15b103fa-130a-4969-abe5-2a91e7b7750d","vulnerability":{"name":"CVE-2026-129483"},"products":[{"@id":"pkg:deb/debian/cyrus-sasl2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdeb13u0%2Bdhi2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdeb13u0%2Bdhi2?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdeb13u0%2Bdhi2?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdeb13u0%2Bdhi2?os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"not_affected","status_notes":"The vulnerable SRP plugin source is absent from the shipped cyrus-sasl2 artifacts. Debian builds cyrus-sasl2 with SRP disabled (--disable-srp, --disable-srp-setpass), and the built libsasl2-2, libsasl2-modules and libsasl2-modules-gssapi-mit packages contain no SRP module and no SRP strings. The SRP plugin was removed upstream in commit fb3724f43dc50247ff2bf02135457d6d77031654 (https://github.com/cyrusimap/cyrus-sasl/commit/fb3724f43dc50247ff2bf02135457d6d77031654). See https://security-tracker.debian.org/tracker/CVE-2026-129483","justification":"vulnerable_code_not_present","timestamp":"2026-11-18T20:19:30.539Z"},{"@id":"09ea6984-f19a-40e2-a9c2-bd0db67bdfd8","vulnerability":{"name":"CVE-2026-107161"},"products":[{"@id":"pkg:deb/debian/cyrus-sasl2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg-10%2Bdeb12u1"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg-10%2Bdeb12u1?arch=amd64\u0026os_distro=bookworm\u0026os_name=debian\u0026os_version=12"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg-10%2Bdeb12u1?arch=arm64\u0026os_distro=bookworm\u0026os_name=debian\u0026os_version=12"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg-10%2Bdeb12u1?os_distro=bookworm\u0026os_name=debian\u0026os_version=12"}],"status":"not_affected","status_notes":"The overflow is in the DIGEST-MD5 plugin's add_to_challenge() implementation. Both amd64 and arm64 Debian 12 builders contain only libsasl2-2 and libsasl2-modules-db; libsasl2-modules and libdigestmd5.so are absent, so the vulnerable implementation is not shipped. Upstream identifies plugins/digestmd5.c: https://github.com/cyrusimap/cyrus-sasl/pull/892. Debian packages that plugin separately: https://packages.debian.org/bookworm/arm64/libsasl2-modules/filelist.","justification":"vulnerable_code_not_present","timestamp":"2026-11-04T08:35:28.349Z"},{"@id":"236928e1-34f8-4cd1-9b16-9a72cfe76493","vulnerability":{"name":"CVE-2026-107161"},"products":[{"@id":"pkg:deb/debian/cyrus-sasl2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg-10%2Bdeb12u1"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg-10%2Bdeb12u1?arch=amd64\u0026os_distro=bookworm\u0026os_name=debian\u0026os_version=12"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg-10%2Bdeb12u1?arch=arm64\u0026os_distro=bookworm\u0026os_name=debian\u0026os_version=12"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg-10%2Bdeb12u1?os_distro=bookworm\u0026os_name=debian\u0026os_version=12"}],"status":"not_affected","status_notes":"The overflow is in the DIGEST-MD5 plugin's add_to_challenge() implementation. Both amd64 and arm64 Debian 12 builders contain only libsasl2-2 and libsasl2-modules-db; libsasl2-modules and libdigestmd5.so are absent, so the vulnerable implementation is not shipped. Upstream identifies plugins/digestmd5.c: https://github.com/cyrusimap/cyrus-sasl/pull/892. Debian packages that plugin separately: https://packages.debian.org/bookworm/arm64/libsasl2-modules/filelist.","justification":"vulnerable_code_not_present","timestamp":"2026-11-04T08:34:19.024Z"},{"@id":"3a7f291f-17ab-5d34-b7ea-41ae8a3a9075","vulnerability":{"name":"CVE-2026-107161"},"products":[{"@id":"pkg:deb/debian/cyrus-sasl2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdeb13u0%2Bdhi2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdeb13u0%2Bdhi2?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdeb13u0%2Bdhi2?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdeb13u0%2Bdhi2?os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi2?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"not_affected","status_notes":"Marked no-dsa by Debian Security Team; see https://security-tracker.debian.org/tracker/CVE-2026-107161","justification":"vulnerable_code_cannot_be_controlled_by_adversary","timestamp":"2026-10-08T14:12:12.565Z"}],"timestamp":"2026-10-08T14:12:12Z","last_updated":"2026-11-25T19:47:17Z"}