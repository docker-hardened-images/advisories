          "@id": "pkg:apk/dhi/dotnet8-runtime@8.0.23-r0?distro=dhi-3.23"
        },
        {
          "@id": "pkg:apk/dhi/dotnet8-runtime@8.0.24-r0?distro=dhi-3.23"
