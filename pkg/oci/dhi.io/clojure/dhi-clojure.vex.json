{"@context":"https://openvex.dev/ns/v0.2.0","@id":"https://dhi.docker.com/vex/vex-1ce2be3e461c55ca4a068a40bfc51285","author":"Docker Hardened Images \u003cdhi@docker.com\u003e","role":"Document Creator","version":1,"statements":[{"@id":"213122d9-85cc-4583-bf1f-1efbb9ec2dff","vulnerability":{"name":"CVE-2025-48924"},"products":[{"@id":"pkg:docker/dhi/clojure","subcomponents":[{"@id":"pkg:maven/commons-lang/commons-lang@2.6"}]},{"@id":"pkg:maven/commons-lang/commons-lang@2.6"},{"@id":"pkg:oci/clojure?repository_url=dhi.io","subcomponents":[{"@id":"pkg:maven/commons-lang/commons-lang@2.6"}]},{"@id":"pkg:oci/dhi.io%2Fclojure","subcomponents":[{"@id":"pkg:maven/commons-lang/commons-lang@2.6"}]}],"status":"not_affected","status_notes":"commons-lang 2.6 is bundled inside the leiningen standalone uber-jar as a transitive dependency of leiningen's build tooling. The 2.x branch of Apache Commons Lang is end-of-life and no upstream fix is planned; users are directed to commons-lang3 (which is also present in this image at 3.18.0 via an explicit dependency patch). The uncontrolled-recursion code path in ClassUtils requires attacker-controlled class-name input, which is not exposed by leiningen during the normal build workflows invoked through the image's entrypoint.","justification":"vulnerable_code_not_in_execute_path","timestamp":"2026-04-30T15:06:43.838Z"},{"@id":"19e0bc21-8422-4854-b4f8-f57331d7fe81","vulnerability":{"name":"CVE-2025-48924"},"products":[{"@id":"pkg:docker/dhi/clojure","subcomponents":[{"@id":"pkg:maven/commons-lang/commons-lang@2.6"}]},{"@id":"pkg:maven/commons-lang/commons-lang@2.6"},{"@id":"pkg:oci/clojure?repository_url=dhi.io","subcomponents":[{"@id":"pkg:maven/commons-lang/commons-lang@2.6"}]},{"@id":"pkg:oci/dhi.io%2Fclojure","subcomponents":[{"@id":"pkg:maven/commons-lang/commons-lang@2.6"}]}],"status":"not_affected","status_notes":"commons-lang 2.6 is bundled inside the leiningen standalone uber-jar as a transitive dependency of leiningen's build tooling. The 2.x branch of Apache Commons Lang is end-of-life and no upstream fix is planned; users are directed to commons-lang3 (which is also present in this image at 3.18.0 via an explicit dependency patch). The uncontrolled-recursion code path in ClassUtils requires attacker-controlled class-name input, which is not exposed by leiningen during the normal build workflows invoked through the image's entrypoint.","justification":"vulnerable_code_not_in_execute_path","timestamp":"2026-04-30T15:06:29.178Z"},{"@id":"46e2577c-bfb3-4934-91a8-954e0b9cb494","vulnerability":{"name":"CVE-2016-2781"},"products":[{"@id":"pkg:apk/alpine/coreutils@9.8-r1"},{"@id":"pkg:apk/alpine/coreutils@9.8-r1?os_name=alpine\u0026os_version=3.23"},{"@id":"pkg:docker/dhi/clojure","subcomponents":[{"@id":"pkg:apk/alpine/coreutils@9.8-r1?os_name=alpine\u0026os_version=3.23"}]},{"@id":"pkg:oci/clojure?repository_url=dhi.io","subcomponents":[{"@id":"pkg:apk/alpine/coreutils@9.8-r1"}]},{"@id":"pkg:oci/dhi.io%2Fclojure","subcomponents":[{"@id":"pkg:apk/alpine/coreutils@9.8-r1"}]}],"status":"not_affected","status_notes":"This CVE requires chroot with --userspec option, which is rarely used in container environments. The vulnerable code path cannot be reached in typical container usage patterns.","justification":"vulnerable_code_cannot_be_controlled_by_adversary","timestamp":"2026-01-27T16:10:09.36Z"},{"@id":"2c9a72c1-5101-42c0-86be-b7a76485e706","vulnerability":{"name":"CVE-2016-2781"},"products":[{"@id":"pkg:apk/alpine/coreutils@9.8-r1"},{"@id":"pkg:apk/alpine/coreutils@9.8-r1?os_name=alpine\u0026os_version=3.23"},{"@id":"pkg:docker/dhi/clojure","subcomponents":[{"@id":"pkg:apk/alpine/coreutils@9.8-r1?os_name=alpine\u0026os_version=3.23"}]},{"@id":"pkg:oci/clojure?repository_url=dhi.io","subcomponents":[{"@id":"pkg:apk/alpine/coreutils@9.8-r1"}]},{"@id":"pkg:oci/dhi.io%2Fclojure","subcomponents":[{"@id":"pkg:apk/alpine/coreutils@9.8-r1"}]}],"status":"not_affected","status_notes":"This CVE requires ch