{"@context":"https://openvex.dev/ns/v0.2.0","@id":"https://dhi.docker.com/vex/vex-924a8d515a9d7890e33739668e2953ff","author":"Docker Hardened Images \u003cdhi@docker.com\u003e","role":"Document Creator","version":7,"statements":[{"@id":"09ea6984-f19a-40e2-a9c2-bd0db67bdfd8","vulnerability":{"name":"CVE-2026-107161"},"products":[{"@id":"pkg:deb/debian/cyrus-sasl2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg-10%2Bdeb12u1"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg-10%2Bdeb12u1?arch=amd64\u0026os_distro=bookworm\u0026os_name=debian\u0026os_version=12"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg-10%2Bdeb12u1?arch=arm64\u0026os_distro=bookworm\u0026os_name=debian\u0026os_version=12"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg-10%2Bdeb12u1?os_distro=bookworm\u0026os_name=debian\u0026os_version=12"}],"status":"not_affected","status_notes":"The overflow is in the DIGEST-MD5 plugin's add_to_challenge() implementation. Both amd64 and arm64 Debian 12 builders contain only libsasl2-2 and libsasl2-modules-db; libsasl2-modules and libdigestmd5.so are absent, so the vulnerable implementation is not shipped. Upstream identifies plugins/digestmd5.c: https://github.com/cyrusimap/cyrus-sasl/pull/892. Debian packages that plugin separately: https://packages.debian.org/bookworm/arm64/libsasl2-modules/filelist.","justification":"vulnerable_code_not_present","timestamp":"2026-11-04T08:35:28.349Z"},{"@id":"236928e1-34f8-4cd1-9b16-9a72cfe76493","vulnerability":{"name":"CVE-2026-107161"},"products":[{"@id":"pkg:deb/debian/cyrus-sasl2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg-10%2Bdeb12u1"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg-10%2Bdeb12u1?arch=amd64\u0026os_distro=bookworm\u0026os_name=debian\u0026os_version=12"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg-10%2Bdeb12u1?arch=arm64\u0026os_distro=bookworm\u0026os_name=debian\u0026os_version=12"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg-10%2Bdeb12u1?os_distro=bookworm\u0026os_name=debian\u0026os_version=12"}],"status":"not_affected","status_notes":"The overflow is in the DIGEST-MD5 plugin's add_to_challenge() implementation. Both amd64 and arm64 Debian 12 builders contain only libsasl2-2 and libsasl2-modules-db; libsasl2-modules and libdigestmd5.so are absent, so the vulnerable implementation is not shipped. Upstream identifies plugins/digestmd5.c: https://github.com/cyrusimap/cyrus-sasl/pull/892. Debian packages that plugin separately: https://packages.debian.org/bookworm/arm64/libsasl2-modules/filelist.","justification":"vulnerable_code_not_present","timestamp":"2026-11-04T08:34:19.024Z"},{"@id":"1c1915e7-2b3f-4e54-ac51-5699f1e09f99","vulnerability":{"name":"CVE-2026-107161"},"products":[{"@id":"pkg:deb/debian/cyrus-sasl2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"not_affected","status_notes":"CVE-2026-107161 affects the Cyrus SASL DIGEST-MD5 plugin (libdigestmd5.so). Debian ships that plugin in the optional libsasl2-modules package (https://packages.debian.org/trixie/amd64/libsasl2-modules/filelist), which this image does not contain. The image contains only the libsasl2 core library and the sasldb plugin.","justification":"vulnerable_code_not_present","timestamp":"2026-10-13T09:16:34.43Z"},{"@id":"d3504ba6-77c5-43cc-a91f-1f1aba109669","vulnerability":{"name":"CVE-2026-107161"},"products":[{"@id":"pkg:deb/debian/cyrus-sasl2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"not_affected","status_notes":"CVE-2026-107161 affects the Cyrus SASL DIGEST-MD5 plugin (libdigestmd5.so). Debian ships that plugin in the optional libsasl2-modules package (https://packages.debian.org/trixie/amd64/libsasl2-modules/filelist), which this image does not contain. The image contains only the libsasl2 core library and the sasldb plugin.","justification":"vulnerable_code_not_present","timestamp":"2026-10-13T09:15:43.363Z"},{"@id":"6c8e9a27-7225-4237-b4c1-fb90038d86cd","vulnerability":{"name":"CVE-2026-107161"},"products":[{"@id":"pkg:deb/debian/cyrus-sasl2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?arch=amd64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?arch=arm64\u0026os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"not_affected","status_notes":"CVE-2026-107161 affects the DIGEST-MD5 plugin's add_to_challenge() function. This image installs only the Cyrus SASL core library and Berkeley DB plugin; it does not install the libsasl2-modules package containing the vulnerable libdigestmd5 plugin. See https://access.redhat.com/security/cve/CVE-2026-107161.","justification":"vulnerable_code_not_present","timestamp":"2026-10-12T17:16:14.16Z"},{"@id":"cbfdf400-0214-4867-a348-ac5c4fcd1001","vulnerability":{"name":"CVE-2026-107161"},"products":[{"@id":"pkg:deb/debian/cyrus-sasl2"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1"},{"@id":"pkg:deb/debian/cyrus-sasl2@2.1.28%2Bdfsg1-9%2Bdhi1?arch=amd64\u0026os_distro=trixie\u0026os_name=d