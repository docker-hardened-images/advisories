{"@context":"https://openvex.dev/ns/v0.2.0","@id":"https://dhi.docker.com/vex/vex-862ed636e4bb76f31662a222b967ac0b","author":"Docker Hardened Images \u003cdhi@docker.com\u003e","role":"Document Creator","version":36,"statements":[{"@id":"27e4c17f-6ac7-4444-abef-ba11ec3c4080","vulnerability":{"name":"CVE-2026-85747"},"products":[{"@id":"pkg:apk/alpine/docker@29.9.2-r1"},{"@id":"pkg:apk/alpine/docker@29.9.2-r1?os_name=alpine\u0026os_version=3.24"},{"@id":"pkg:docker/dhi/docker-dind","subcomponents":[{"@id":"pkg:apk/alpine/docker@29.9.2-r1?os_name=alpine\u0026os_version=3.24"}]},{"@id":"pkg:oci/dhi.io%2Fdocker-dind","subcomponents":[{"@id":"pkg:apk/alpine/docker@29.9.2-r1"}]},{"@id":"pkg:oci/docker-dind?repository_url=dhi.io","subcomponents":[{"@id":"pkg:apk/alpine/docker@29.9.2-r1"}]}],"status":"not_affected","status_notes":"CVE-2026-85747 (GHSA-685w-q87j-wqw3) is a missing digest check in the github.com/docker/distribution registry client: manifests and blobs fetched by digest were returned without being hashed, so a malicious registry could substitute content. docker/distribution v2.8.3 has no fixed release; the fix shipped in distribution v3.1.2 as commits https://github.com/distribution/distribution/commit/8f91c26c8888a95a36c2357a6e30bc15d4dd76d3 (manifests) and https://github.com/distribution/distribution/commit/93c6e1a3b3c874a73fbd6b8fa9b37577223cff9e (blobs). The docker 29.9.2-r1 packages apply both changes to the registry client vendored in Moby 29.9.2, so dockerd rejects manifest and blob content that does not match the requested digest. The module version reported by go version -m stays v2.8.3+incompatible because the fix is applied to vendored source. Advisory: https://github.com/distribution/distribution/security/advisories/GHSA-685w-q87j-wqw3","justification":"inline_mitigations_already_exist","timestamp":"2026-10-27T13:02:39.253Z"},{"@id":"56c1956a-ffae-424e-8c82-cf16cab1b3fd","vulnerability":{"name":"CVE-2026-85747"},"products":[{"@id":"pkg:apk/alpine/docker@29.9.2-r1"},{"@id":"pkg:apk/alpine/docker@29.9.2-r1?os_name=alpine\u0026os_version=3.24"},{"@id":"pkg:docker/dhi/docker-dind","subcomponents":[{"@id":"pkg:apk/alpine/docker@29.9.2-r1?os_name=alpine\u0026os_version=3.24"},{"@id":"pkg:golang/github.com/docker/distribution@2.8.3%2Bincompatible"}]},{"@id":"pkg:golang/github.com/docker/distribution@2.8.3%2Bincompatible"},{"@id":"pkg:oci/dhi.io%2Fdocker-dind","subcomponents":[{"@id":"pkg:apk/alpine/docker@29.9.2-r1"},{"@id":"pkg:golang/github.com/docker/distribution@2.8.3%2Bincompatible"}]},{"@id":"pkg:oci/docker-dind?repository_url=dhi.io","subcomponents":[{"@id":"pkg:apk/alpine/docker@29.9.2-r1"},{"@id":"pkg:golang/github.com/docker/distribution@2.8.3%2Bincompatible"}]}],"status":"not_affected","status_notes":"CVE-2026-85747 (GHSA-685w-q87j-wqw3) is a missing digest check in the github.com/docker/distribution registry client: manifests and blobs fetched by digest were returned without being hashed, so a malicious registry could substitute content. docker/distribution v2.8.3 has no fixed release; the fix shipped in distribution v3.1.2 as commits https://github.com/distribution/distribution/commit/8f91c26c8888a95a36c2357a6e30bc15d4dd76d3 (manifests) and https://github.com/distribution/distribution/commit/93c6e1a3b3c874a73fbd6b8fa9b37577223cff9e (blobs). The docker 29.9.2-r1 packages apply both changes to the registry client vendored in Moby 29.9.2, so dockerd rejects manifest and blob content that does not match the requested digest. The module version reported by go version -m stays v2.8.3+incompatible because the fix is applied to vendored source. Advisory: https://github.com/distribution/distribution/security/advisories/GHSA-685w-q87j-wqw3","justification":"inline_mitigations_already_exist","timestamp":"2026-10-27T13:01:44.697Z"},{"@id":"8801a380-9883-4994-963e-23ff497809d7","vulnerability":{"name":"CVE-2026-107891"},"products":[{"@id":"pkg:apk/alpine/musl@1.2.6-r3"},{"@id":"pkg:apk/alpine/musl@1.2.6-r3?os_name=a