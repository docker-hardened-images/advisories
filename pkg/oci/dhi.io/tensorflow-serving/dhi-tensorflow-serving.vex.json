rability scanner incorrectly flags zlib packages as vulnerable when the untgz utility is not actually present in the installed packages.","justification":"vulnerable_code_not_present","timestamp":"2026-01-08T08:59:57.167Z"},{"@id":"40a02b39-b99d-4051-a5d1-a63351974b01","vulnerability":{"name":"CVE-2026-22184"},"products":[{"@id":"pkg:deb/debian/lib32z1"},{"@id":"pkg:deb/debian/lib32z1-dev"},{"@id":"pkg:deb/debian/lib64z1"},{"@id":"pkg:deb/debian/lib64z1-dev"},{"@id":"pkg:deb/debian/libn32z1"},{"@id":"pkg:deb/debian/libn32z1-dev"},{"@id":"pkg:deb/debian/zlib1g@1%3A1.3.dfsg%2Breally1.3.1-1%2Bb1"},{"@id":"pkg:deb/debian/zlib1g@1%3A1.3.dfsg%2Breally1.3.1-1%2Bb1?os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:docker/dhi/tensorflow-serving","subcomponents":[{"@id":"pkg:deb/debian/lib32z1"},{"@id":"pkg:deb/debian/lib32z1-dev"},{"@id":"pkg:deb/debian/lib64z1"},{"@id":"pkg:deb/debian/lib64z1-dev"},{"@id":"pkg:deb/debian/libn32z1"},{"@id":"pkg:deb/debian/libn32z1-dev"},{"@id":"pkg:deb/debian/zlib1g@1%3A1.3.dfsg%2Breally1.3.1-1%2Bb1?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}]},{"@id":"pkg:oci/dhi.io%2Ftensorflow-serving","subcomponents":[{"@id":"pkg:deb/debian/lib32z1"},{"@id":"pkg:deb/debian/lib32z1-dev"},{"@id":"pkg:deb/debian/lib64z1"},{"@id":"pkg:deb/debian/lib64z1-dev"},{"@id":"pkg:deb/debian/libn32z1"},{"@id":"pkg:deb/debian/libn32z1-dev"},{"@id":"pkg:deb/debian/zlib1g@1%3A1.3.dfsg%2Breally1.3.1-1%2Bb1"}]},{"@id":"pkg:oci/tensorflow-serving?repository_url=dhi.io","subcomponents":[{"@id":"pkg:deb/debian/lib32z1"},{"@id":"pkg:deb/debian/lib32z1-dev"},{"@id":"pkg:deb/debian/lib64z1"},{"@id":"pkg:deb/debian/lib64z1-dev"},{"@id":"pkg:deb/debian/libn32z1"},{"@id":"pkg:deb/debian/libn32z1-dev"},{"@id":"pkg:deb/debian/zlib1g@1%3A1.3.dfsg%2Breally1.3.1-1%2Bb1"}]}],"status":"not_affected","status_notes":"False positive. CVE-2026-22184 affects the untgz utility that is part of zlib source code, but Debian zlib packages (zlib1g and zlib1g-dev) do