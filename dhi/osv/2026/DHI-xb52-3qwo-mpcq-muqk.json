{
  "schema_version": "1.8.0",
  "id": "DHI-xb52-3qwo-mpcq-muqk",
  "modified": "2026-11-25T02:15:41Z",
  "published": "2026-11-19T20:59:10Z",
  "upstream": [
    "CVE-2026-54514"
  ],
  "summary": "jackson-databind contains the general-purpose data-binding functionality and tree-model for Jackson Data Processor…",
  "details": "jackson-databind contains the general-purpose data-binding functionality and tree-model for Jackson Data Processor. From 2.0.0 until 2.18.8, 2.21.4, and 3.1.4, JDKFromStringDeserializer constructed InetSocketAddress with new InetSocketAddress(host, port), which performs eager DNS name resolution for hostname inputs at deserialization time. An application that binds untrusted JSON into a type containing an InetSocketAddress field issues an attacker-chosen DNS query during readValue, before any application-level validation or connect logic. The fix uses InetSocketAddress.createUnresolved(host, port), deferring DNS to an explicit connect. This vulnerability is fixed in 2.18.8, 2.21.4, and 3.1.4.",
  "severity": [
    {
      "type": "CVSS_V3",
      "score": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:N/A:N"
    }
  ],
