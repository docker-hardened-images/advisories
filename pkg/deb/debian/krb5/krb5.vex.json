{"@context":"https://openvex.dev/ns/v0.2.0","@id":"https://dhi.docker.com/vex/vex-6446a5e053860f2a775eed06c9c2c532","author":"Docker Hardened Images \u003cdhi@docker.com\u003e","role":"Document Creator","version":28,"statements":[{"@id":"7bcdfe4d-5106-462f-971e-a6aaa513f277","vulnerability":{"name":"CVE-2026-11850"},"products":[{"@id":"pkg:deb/debian/krb5"},{"@id":"pkg:deb/debian/krb5@1.21.3-5"},{"@id":"pkg:deb/debian/krb5@1.21.3-5%2Bdeb13u1"},{"@id":"pkg:deb/debian/krb5@1.21.3-5%2Bdeb13u1?os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/krb5@1.21.3-5%2Bdhi2"},{"@id":"pkg:deb/debian/krb5@1.21.3-5%2Bdhi2?os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/krb5@1.21.3-5?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"not_affected","status_notes":"Integer underflow and heap out-of-bounds read in berval2tl_data() in the LDAP KDB backend plugin (plugins/kdb/ldap/libkdb_ldap/ldap_principal2.c). Triggering requires a KDC or kadmind configured with an LDAP database backend whose backend returns a krbExtraData attribute with bv_len \u003c 2; that data originates from the trusted KDB datastore, not from an external Kerberos protocol client, so it cannot be controlled by an adversary. Debian marks this unimportant (bug 1139821) with no security impact and notes it does not cross any security boundary.","justification":"vulnerable_code_cannot_be_controlled_by_adversary","timestamp":"2026-06-18T22:35:18.563Z"},{"@id":"f0b94838-1f37-4a32-8a4c-6f40c2de4eb6","vulnerability":{"name":"CVE-2026-11850"},"products":[{"@id":"pkg:deb/debian/krb5"},{"@id":"pkg:deb/debian/krb5@1.21.3-5"},{"@id":"pkg:deb/debian/krb5@1.21.3-5%2Bdeb13u1"},{"@id":"pkg:deb/debian/krb5@1.21.3-5%2Bdeb13u1?os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/krb5@1.21.3-5%2Bdhi2"},{"@id":"pkg:deb/debian/krb5@1.21.3-5%2Bdhi2?os_distro=trixie\u0026os_name=debian\u0026os_version=13"},{"@id":"pkg:deb/debian/krb5@1.21.3-5?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"not_affected","status_notes":"Integer underflow and heap out-of-bounds read in berval2tl_data() in the LDAP KDB backend plugin (plugins/kdb/ldap/libkdb_ldap/ldap_principal2.c). Triggering requires a KDC or kadmind configured with an LDAP database backend whose backend returns a krbExtraData attribute with bv_len \u003c 2; that data originates from the trusted KDB datastore, not from an external Kerberos protocol client, so it cannot be controlled by an adversary. Debian marks this unimportant (bug 1139821) with no security impact and notes it does not cross any security boundary.","justification":"vulnerable_code_cannot_be_controlled_by_adversary","timestamp":"2026-06-18T22:35:10.173Z"},{"@id":"135bfaf1-84ab-439a-8a4d-2bca7e9bc8f5","vulnerability":{"name":"CVE-2026-40356"},"products":[{"@id":"pkg:deb/debian/krb5"},{"@id":"pkg:deb/debian/krb5@1.21.3-5"},{"@id":"pkg:deb/debian/krb5@1.21.3-5?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"under_investigation","status_notes":"Integer underflow and out-of-bounds read in gss_accept_sec_context() with NegoEx mechanism. Waiting for Debian security update; upstream fix available in krb5 1.22.3.","timestamp":"2026-05-13T04:42:59.657Z"},{"@id":"4e01a6db-b17b-43cb-8ac4-710c9250b31f","vulnerability":{"name":"CVE-2026-40355"},"products":[{"@id":"pkg:deb/debian/krb5"},{"@id":"pkg:deb/debian/krb5@1.21.3-5"},{"@id":"pkg:deb/debian/krb5@1.21.3-5?os_distro=trixie\u0026os_name=debian\u0026os_version=13"}],"status":"under_investigation","status_notes":"NULL pointer dereference in gss_accept_sec_context() with NegoEx mechanism. Waiting for Debian security update; upstream fix available in krb5 1.22.3.","timestamp":"2026-05-13T04:42:58.71Z"},{"@id":"563fd891-180c-4151-9917-823f6e970d81","vulnerability":{"name":"CVE-2026-40356"},"products":[{"@id":"pkg:deb/debian/krb5"},{"@id":"pkg:deb/debian/krb5@1.21.3-5"},{"@id":"pkg:deb/debian/krb5@1.21